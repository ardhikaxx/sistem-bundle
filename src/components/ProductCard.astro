---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<a
	href={`/docs/${project.slug}`}
	class="group flex h-full flex-col border border-neutral-900 bg-white p-6 transition hover:-translate-y-1 hover:bg-neutral-100"
>
	<p class="font-mono text-[11px] uppercase tracking-[0.25em] text-neutral-500">{project.short}</p>
	<h3 class="mt-3 text-2xl font-black tracking-tight">{project.name}</h3>
	<p class="mt-3 flex-grow text-sm leading-relaxed text-neutral-600">{project.description}</p>
	<span class="mt-6 inline-flex items-center gap-2 font-mono text-xs font-semibold underline-offset-4 group-hover:underline">
		Lihat Detail <span aria-hidden="true">→</span>
	</span>
</a>