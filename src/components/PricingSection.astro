---
import { bundle, projects } from '../data/projects';

const WHATSAPP_NUMBER = '6285933648537';
const QRIS_PAYLOAD = '00020101021126610014COM.GO-JEK.WWW01189360091438465549940210G8465549940303UMI51440014ID.CO.QRIS.WWW0215ID10264739285820303UMI5204899953033605802ID5925Yanuar Ardhika ID, Digita6009BONDOWOSO61056828162070703A01';
const AMOUNT = '49000';
---

<script is:inline type="application/json" id="payment-config">
{"payload":"00020101021126610014COM.GO-JEK.WWW01189360091438465549940210G8465549940303UMI51440014ID.CO.QRIS.WWW0215ID10264739285820303UMI5204899953033605802ID5925Yanuar Ardhika ID, Digita6009BONDOWOSO61056828162070703A01","amount":"49000","wa":"6285933648537"}
</script>

<section id="harga" class="border-b border-neutral-900">
	<div class="mx-auto max-w-5xl px-6 py-20">
		<div class="mb-12 text-center">
			<p class="font-mono text-xs uppercase tracking-[0.3em] text-neutral-500">Harga Spesial</p>
			<h2 class="mt-4 text-3xl font-black tracking-tight sm:text-4xl">Satu Paket, Lima Sistem</h2>
		</div>

		<div class="mx-auto max-w-3xl border border-neutral-900">
			<div class="grid md:grid-cols-2">
				<div class="flex flex-col items-center justify-center border-b border-neutral-900 p-8 md:border-b-0 md:border-r md:border-neutral-900">
					<p class="font-mono text-xs uppercase tracking-[0.3em] text-neutral-500">Bundle Lengkap</p>
					<span class="mt-4 text-lg text-neutral-400 line-through">{bundle.priceOriginal}</span>
					<div class="mt-1 text-5xl font-black tracking-tight">{bundle.price}</div>
					<p class="mt-2 font-mono text-xs text-neutral-500">{bundle.priceLabel}</p>
				</div>

				<div class="flex flex-col p-8">
					<p class="font-mono text-xs uppercase tracking-[0.3em] text-neutral-500">Yang Anda Dapatkan</p>
					<div class="mt-4 flex-1 space-y-3">
						{projects.map((p) => (
							<div class="flex items-start gap-3">
								<span class="mt-0.5 font-mono text-sm text-neutral-900">✓</span>
								<div>
									<span class="font-mono text-sm font-bold">{p.name}</span>
									<span class="ml-2 text-xs text-neutral-500">— {p.short}</span>
								</div>
							</div>
						))}
					</div>

					<button
						id="btn-beli"
						class="mt-8 w-full border border-neutral-900 bg-neutral-900 px-6 py-3 font-mono text-sm font-bold text-white transition hover:bg-neutral-700"
					>
						Beli Sekarang
					</button>

					<p class="mt-3 font-mono text-[10px] uppercase tracking-wider text-neutral-400 text-center">
						Pembayaran via QRIS · File dikirim via WhatsApp
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<div id="modal-form" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4">
	<div class="w-full max-w-md border border-neutral-900 bg-white p-8">
		<div class="flex items-center justify-between">
			<h3 class="text-xl font-black tracking-tight">Data Pembeli</h3>
			<button id="close-form" class="text-2xl leading-none text-neutral-400 hover:text-neutral-900">&times;</button>
		</div>
		<form id="form-beli" class="mt-6 space-y-4">
			<div>
				<label for="input-nama" class="mb-1 block font-mono text-xs font-semibold uppercase tracking-wider text-neutral-500">Nama Lengkap</label>
				<input id="input-nama" type="text" required minlength="2" placeholder="Masukkan nama Anda" class="w-full border border-neutral-300 px-4 py-2.5 font-mono text-sm outline-none transition focus:border-neutral-900" />
			</div>
			<div>
				<label for="input-wa" class="mb-1 block font-mono text-xs font-semibold uppercase tracking-wider text-neutral-500">Nomor WhatsApp</label>
				<input id="input-wa" type="tel" required pattern="(08|\+628)\d{8,13}" placeholder="08xxxxxxxxxx" class="w-full border border-neutral-300 px-4 py-2.5 font-mono text-sm outline-none transition focus:border-neutral-900" />
				<p class="mt-1 font-mono text-[10px] text-neutral-400">Contoh: 081234567890 atau +6281234567890</p>
			</div>
			<button type="submit" class="w-full border border-neutral-900 bg-neutral-900 px-6 py-3 font-mono text-sm font-bold text-white transition hover:bg-neutral-700">Lanjut ke Pembayaran →</button>
		</form>
	</div>
</div>

<div id="modal-qris" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4">
	<div class="w-full max-w-md border border-neutral-900 bg-white p-8 text-center">
		<div class="flex items-center justify-between">
			<h3 class="text-xl font-black tracking-tight">Pembayaran QRIS</h3>
			<button id="close-qris" class="text-2xl leading-none text-neutral-400 hover:text-neutral-900">&times;</button>
		</div>
		<div class="mt-6">
			<p class="font-mono text-xs uppercase tracking-wider text-neutral-500">Scan QRIS ini</p>
			<p class="mt-1 font-mono text-2xl font-black">{bundle.price}</p>
		</div>
		<div class="mt-6 flex justify-center">
			<div id="qris-loading" class="py-8 text-sm text-neutral-500">Memuat QRIS...</div>
			<canvas id="qris-canvas" class="hidden border border-neutral-200"></canvas>
		</div>
		<p id="qris-hint" class="mt-4 text-xs text-neutral-500">
			Buka aplikasi banking/e-wallet → Scan → Masukkan nominal <strong>{bundle.price}</strong> jika tidak otomatis
		</p>
		<div class="mt-6 flex gap-3">
			<button id="btn-wa" class="flex-1 border border-neutral-900 bg-neutral-900 px-6 py-3 font-mono text-sm font-bold text-white transition hover:bg-neutral-700">Kirim Bukti ke WhatsApp →</button>
			<button id="btn-copy" class="border border-neutral-300 px-4 py-3 font-mono text-sm text-neutral-600 transition hover:border-neutral-900 hover:text-neutral-900">Copy Nominal</button>
		</div>
		<p class="mt-3 font-mono text-[10px] text-neutral-400">Pastikan nominal Rp{bundle.price} sesuai saat scan. Kirim bukti ke WhatsApp setelah pembayaran.</p>
	</div>
</div>

<script is:inline>
(function() {
	var config = JSON.parse(document.getElementById('payment-config').textContent);
	var BASE_PAYLOAD = config.payload;
	var AMOUNT = parseInt(config.amount, 10);
	var WHATSAPP_NUMBER = config.wa;
	var buyerData = { nama: '', wa: '' };

	function crc16(str) {
		var poly = 0x1021;
		var crc = 0xFFFF;
		for (var i = 0; i < str.length; i++) {
			crc ^= str.charCodeAt(i) << 8;
			for (var j = 0; j < 8; j++) {
				if (crc & 0x8000) {
					crc = ((crc << 1) ^ poly) & 0xFFFF;
				} else {
					crc = (crc << 1) & 0xFFFF;
				}
			}
		}
		return crc;
	}

	function padZero(n) {
		return n < 10 ? '0' + n : '' + n;
	}

	function generateDynamicQRIS(amount) {
		var payload = BASE_PAYLOAD.replace('010211', '010212');
		var amountStr = amount.toString();
		var amountTag = '54' + padZero(amountStr.length) + amountStr;
		var insertPos = payload.indexOf('5802ID');
		var newPayload;
		if (insertPos !== -1) {
			newPayload = payload.substring(0, insertPos) + amountTag + payload.substring(insertPos);
		} else {
			newPayload = payload + amountTag;
		}
		var checksumPayload = newPayload + '6304';
		var crc = crc16(checksumPayload);
		var crcHex = crc.toString(16).toUpperCase().padStart(4, '0');
		return newPayload + '6304' + crcHex;
	}

	function showQR(text) {
		if (typeof qrcode === 'undefined') {
			document.getElementById('qris-loading').textContent = 'QR library not loaded. Refresh page.';
			return;
		}
		var qr = qrcode(0, 'M');
		qr.addData(text);
		qr.make();
		var ctx = document.getElementById('qris-canvas').getContext('2d');
		var moduleCount = qr.getModuleCount();
		var scale = 4;
		var quiet = 4;
		var total = moduleCount + quiet * 2;
		var canvas = document.getElementById('qris-canvas');
		canvas.width = total * scale;
		canvas.height = total * scale;
		ctx.fillStyle = '#ffffff';
		ctx.fillRect(0, 0, canvas.width, canvas.height);
		ctx.fillStyle = '#000000';
		for (var r = 0; r < moduleCount; r++) {
			for (var c = 0; c < moduleCount; c++) {
				if (qr.isDark(r, c)) {
					ctx.fillRect((quiet + c) * scale, (quiet + r) * scale, scale, scale);
				}
			}
		}
		document.getElementById('qris-loading').classList.add('hidden');
		canvas.classList.remove('hidden');
	}

	function openFormModal() {
		document.getElementById('modal-form').classList.remove('hidden');
		document.getElementById('modal-form').classList.add('flex');
	}

	function closeFormModal() {
		document.getElementById('modal-form').classList.add('hidden');
		document.getElementById('modal-form').classList.remove('flex');
	}

	function closeQRISModal() {
		document.getElementById('modal-qris').classList.add('hidden');
		document.getElementById('modal-qris').classList.remove('flex');
	}

	function openQRISModal() {
		document.getElementById('qris-loading').classList.remove('hidden');
		document.getElementById('qris-canvas').classList.add('hidden');
		document.getElementById('modal-qris').classList.remove('hidden');
		document.getElementById('modal-qris').classList.add('flex');
	}

	document.getElementById('btn-beli').addEventListener('click', openFormModal);
	document.getElementById('close-form').addEventListener('click', closeFormModal);
	document.getElementById('close-qris').addEventListener('click', closeQRISModal);

	document.getElementById('modal-form').addEventListener('click', function(e) {
		if (e.target === document.getElementById('modal-form')) closeFormModal();
	});
	document.getElementById('modal-qris').addEventListener('click', function(e) {
		if (e.target === document.getElementById('modal-qris')) closeQRISModal();
	});

	document.getElementById('form-beli').addEventListener('submit', function(e) {
		e.preventDefault();
		var nama = document.getElementById('input-nama').value.trim();
		var wa = document.getElementById('input-wa').value.trim();
		if (nama.length < 2) { document.getElementById('input-nama').focus(); return; }
		var waNorm = wa.replace(/\s|-/g, '');
		if (waNorm.startsWith('0')) { waNorm = '62' + waNorm.substring(1); }
		else if (waNorm.startsWith('+62')) { waNorm = waNorm.substring(1); }
		else if (!waNorm.startsWith('62')) { document.getElementById('input-wa').focus(); return; }
		buyerData = { nama: nama, wa: waNorm };
		closeFormModal();
		openQRISModal();
		try {
			var dynamicPayload = generateDynamicQRIS(AMOUNT);
			showQR(dynamicPayload);
			document.getElementById('qris-hint').classList.remove('hidden');
		} catch(err) {
			document.getElementById('qris-loading').textContent = 'Error: ' + err.message;
		}
	});

	function redirectToWhatsApp() {
		var msg = 'Halo, saya ingin membeli Bundle 5 Sistem Laravel 13.\n\nNama: ' + buyerData.nama + '\nNo. HP: ' + buyerData.wa + '\nHarga: Rp' + AMOUNT.toLocaleString('id-ID') + '\n\nBerikut bukti pembayarannya:';
		window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(msg), '_blank');
	}

	document.getElementById('btn-wa').addEventListener('click', redirectToWhatsApp);
	document.getElementById('btn-copy').addEventListener('click', function() {
		navigator.clipboard.writeText(AMOUNT.toString()).then(function() {
			document.getElementById('btn-copy').textContent = 'Tersalin!';
			setTimeout(function() { document.getElementById('btn-copy').textContent = 'Copy Nominal'; }, 2000);
		});
	});
})();
</script>
