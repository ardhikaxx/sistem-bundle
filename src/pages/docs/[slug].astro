---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { projects } from '../../data/projects';

export const prerender = true;

export async function getStaticPaths() {
	const entries = await getCollection('projects');

	return entries.map((entry) => {
		const meta = projects.find((p) => p.slug === entry.id);

		return {
			params: { slug: entry.id },
			props: { entry, meta },
		};
	});
}

const { entry, meta } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${meta?.name ?? entry.id} — Dokumentasi`} description={meta?.description}>
	<header class="border-b border-neutral-900">
		<div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5">
			<a href="/" class="font-mono text-xs font-semibold underline-offset-4 hover:underline">← Kembali ke Beranda</a>
			<span class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">
				{meta?.short ?? 'Dokumentasi'}
			</span>
		</div>
	</header>

	<main class="mx-auto max-w-4xl px-6 py-12">
		<div class="mb-10 border-b border-neutral-200 pb-8">
			<p class="font-mono text-xs uppercase tracking-[0.3em] text-neutral-500">
				{meta?.slug ?? entry.id}
			</p>
			<h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">{meta?.name ?? entry.id}</h1>
			<p class="mt-3 text-sm text-neutral-600">{meta?.readme}</p>
		</div>

		<article class="prose prose-neutral max-w-none">
			<Content />
		</article>
	</main>

	<Footer />
</Layout>