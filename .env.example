# GoPay Merchant Gateway
# Repository: https://github.com/ahmadzakiyox/gopay-api-gateaway
# Deploy gateway di VPS dulu, lalu isi URL dan API Key di bawah ini

# URL gateway (contoh: https://gopay.domainkamu.com)
GATEWAY_URL=

# API Key dari gateway (buat di .env gateway)
GATEWAY_API_KEY=

# Nomor HP GoPay Merchant yang terdaftar
GOPAY_MERCHANT_PHONE=your_phone_number_here

# Merchant Code
GOPAY_MERCHANT_CODE=your_merchant_code_here
