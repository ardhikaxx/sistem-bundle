# GoPay Merchant (GoBiz) Credentials
# Daftar di https://gobiz.co.id
# Gunakan sandbox untuk testing, production untuk live

# "sandbox" atau "production"
GOPAY_ENV=sandbox

# Client ID dari GoBiz Dashboard
GOPAY_CLIENT_ID=your_client_id_here

# Client Secret dari GoBiz Dashboard
GOPAY_CLIENT_SECRET=your_client_secret_here

# Merchant Code dari GoBiz Dashboard
GOPAY_MERCHANT_CODE=your_merchant_code_here

# Callback URL (opsional)
GOPAY_CALLBACK_URL=
